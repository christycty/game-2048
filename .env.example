# Host uvicorn only (server/.env). Compose sets APP_ENV per service and ignores this.
# APP_ENV=dev
OLLAMA_MODEL=gemma4:latest
# Opt in to Ollama JSON schema (`format=`). Off by default; many models return
# 501 when structured output is unavailable. Prod always keeps this off.
OLLAMA_STRUCTURED_OUTPUT=false
LLM_MAX_ATTEMPTS=3
LLM_ATTEMPT_TIMEOUT_SECONDS=20
LLM_SUGGEST_BUDGET_SECONDS=40
# Per-mode hard ceiling (spend safety). Capacity gates are *_MAX_IN_FLIGHT.
SUGGEST_RATE_LIMIT_REQUESTS=60
# ~4 Expectimax Auto Play tabs @ upper-bound settle+gap cadence (see runtime.md).
SUGGEST_RATE_LIMIT_EXPECTIMAX_REQUESTS=360
SUGGEST_RATE_LIMIT_WINDOW_SECONDS=60
LLM_MAX_IN_FLIGHT=1
# Concurrent Expectimax searches (CPU). Default matches 4-tab demo load.
EXPECTIMAX_MAX_IN_FLIGHT=4
# Beacon integrity gate for POST /client-events (separate from suggest buckets).
CLIENT_EVENTS_RATE_LIMIT_REQUESTS=60
CLIENT_EVENTS_RATE_LIMIT_WINDOW_SECONDS=60
# Unique per worktree so Compose networks/volumes and published ports do not
# collide with another checkout on the same machine.
COMPOSE_PROJECT_NAME=game-2048
API_HOST_PORT=8000
CLIENT_HOST_PORT=5173
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
# Optional URL for the API container. Leave unset so Compose keeps
# http://host.docker.internal:11434.
# Do not set OLLAMA_BASE_URL here. That name is the host process URL
# (server/.env.example uses localhost) and Compose ignores it.
# Linux Docker Engine cannot reach an Ollama that listens only on
# 127.0.0.1. Start that Ollama with OLLAMA_HOST=0.0.0.0.
# COMPOSE_OLLAMA_BASE_URL=
# OTLP export is off until Phoenix (or another collector) runs on the host.
# Do not set PHOENIX_COLLECTOR_ENDPOINT here: that name is the host process URL
# (server/.env.example uses localhost).
# COMPOSE_PHOENIX_COLLECTOR_ENDPOINT=http://host.docker.internal:6006
# EXPORT_TRACES=true
# PHOENIX_API_KEY=

# Optional scrapers: docker compose --profile dev --profile metrics up
# (see observability/README.md).
