APP_ENV=dev
OLLAMA_MODEL=llama3.2
LLM_MAX_ATTEMPTS=3
# Optional Compose overrides. Leave unset so the API container keeps
# http://host.docker.internal:11434 and http://phoenix:6006.
# OLLAMA_BASE_URL=
# PHOENIX_COLLECTOR_ENDPOINT=
# Outbound header for the API when Phoenix requires a key. It does not lock the UI.
PHOENIX_API_KEY=
