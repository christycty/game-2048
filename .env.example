APP_ENV=dev
OLLAMA_MODEL=gemma4:latest
LLM_MAX_ATTEMPTS=3
LLM_ATTEMPT_TIMEOUT_SECONDS=10
LLM_SUGGEST_BUDGET_SECONDS=20

# Compose-only overrides (host uvicorn uses server/.env instead).
# Leave unset for host.docker.internal defaults. Do not set OLLAMA_BASE_URL or
# PHOENIX_COLLECTOR_ENDPOINT here — those names are for the host process.
# COMPOSE_OLLAMA_BASE_URL=
# COMPOSE_PHOENIX_COLLECTOR_ENDPOINT=
# PHOENIX_API_KEY=

# Optional scrapers: docker compose --profile dev --profile metrics up
# (see observability/README.md). Linux Ollama may need OLLAMA_HOST=0.0.0.0.
