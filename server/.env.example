# For uvicorn on the host. Compose does not read this file.
# The API container gets its URL from COMPOSE_OLLAMA_BASE_URL in the repo-root .env.
APP_ENV=dev
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
LLM_MAX_ATTEMPTS=3
LLM_ATTEMPT_TIMEOUT_SECONDS=10
LLM_SUGGEST_BUDGET_SECONDS=20
# Dev and prod export traces to Phoenix (OTLP). CI sets EXPORT_TRACES=false.
# GenAI histograms are always on GET /metrics. Optional Compose Prometheus/Grafana:
#   docker compose --profile dev --profile metrics up  (see observability/README.md)
EXPORT_TRACES=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
