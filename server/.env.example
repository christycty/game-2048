# Host uvicorn only. Compose reads the repo-root .env (COMPOSE_* URLs).
# The API container gets its URL from COMPOSE_OLLAMA_BASE_URL in the repo-root .env.
APP_ENV=dev
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# Opt in to Ollama JSON schema (`format=`). Off by default; prod always keeps it off.
OLLAMA_STRUCTURED_OUTPUT=false
LLM_MAX_ATTEMPTS=3
LLM_ATTEMPT_TIMEOUT_SECONDS=20
LLM_SUGGEST_BUDGET_SECONDS=40
# LLM hard ceiling (spend safety). Capacity gate is LLM_MAX_IN_FLIGHT.
# Expectimax has a separate window for Auto Play.
SUGGEST_RATE_LIMIT_REQUESTS=60
SUGGEST_RATE_LIMIT_EXPECTIMAX_REQUESTS=30
SUGGEST_RATE_LIMIT_WINDOW_SECONDS=60
LLM_MAX_IN_FLIGHT=1
# Must match the Vite / Compose CLIENT_HOST_PORT for CORS when the page
# calls the API origin directly (same-origin /suggest does not need CORS).
CLIENT_HOST_PORT=5173
# Traces on in dev/prod; CI sets EXPORT_TRACES=false. Metrics: GET /metrics.
EXPORT_TRACES=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
