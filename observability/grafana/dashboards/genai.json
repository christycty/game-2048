    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "All status codes on one chart. Unstacked lines — each series Y is absolute req/s (429 is not stacked on top of 200).",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none", "group": "A" },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 1 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{http_target=\"/suggest\"}[5m])) > 0",
          "legendFormat": "{{http_status_code}}",
          "refId": "A"
